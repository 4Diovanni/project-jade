# ─────────────────────────────────────────────────────────────
# Project Jade — variáveis de ambiente (copie para .env)
#   cp .env.example .env    (ou copy no Windows)
# NUNCA commite o arquivo .env — ele está no .gitignore.
# ─────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────
# Provider ativo: ollama | openai | anthropic | gemini
JADE_LLM_PROVIDER=ollama

# Opção 1 — 100% local e privado (Ollama)
# qwen3:8b: tool-calling nativo, 32K de contexto e PT-BR sólido; cabe em 8 GB
# de VRAM (ollama pull qwen3:8b). O llama3 antigo não tem tool-calling e
# tende a responder em inglês.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text   # embeddings do RAG (ollama pull nomic-embed-text)
# Janela de contexto. O default do Ollama (2k–4k) trunca em silêncio o system
# prompt + histórico + trechos do RAG. 10240 é o teto para o qwen3:8b caber
# 100% na VRAM de uma GPU de 8 GB — acima disso ele vaza para a CPU e a
# geração cai pela metade. Com mais VRAM, pode subir (o Qwen3 aceita 32K).
OLLAMA_NUM_CTX=10240
# Temperatura do papo solto vs. das respostas ancoradas no vault (RAG/tools).
OLLAMA_TEMPERATURE=0.7
OLLAMA_GROUNDED_TEMPERATURE=0.2
# Modo "thinking" do Qwen3. Ligado, ele raciocina antes de responder — mais
# lento e polui a fala da Jade. Deixe false para o chat.
OLLAMA_THINKING=false

# Opção 2 — nuvem (preencha só o que for usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Roteador dual-model (Qwen3 local + Claude na nuvem) ──────
# Com ANTHROPIC_API_KEY preenchida, perguntas informativas/complexas vão para
# o Claude; conversa comum e dados pessoais ficam no modelo local (privacidade).
# A chave vem do console.anthropic.com (≠ assinatura Claude Pro).
JADE_ROUTER_ENABLED=true
JADE_CLOUD_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-4-8
# Modelo mais barato para o escalonamento (opcional):
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Sessão / histórico ────────────────────────────────────────
# Quantas trocas (pergunta+resposta) ficam no histórico ativo do prompt.
# HISTORY_MAX_TURNS=20

# ── Obsidian (RAG) ───────────────────────────────────────────
# O que a Jade LÊ. "." = a raiz deste repositório É o vault, então ela
# enxerga também os documentos do próprio projeto (README, arquitetura).
# Filtre o que não deve entrar no RAG via VAULT_IGNORE (core/config.py).
OBSIDIAN_VAULT_PATH=.

# Onde a Jade ESCREVE (conversas, notas internas de humor/perfil, áudios).
# Separado do vault de leitura de propósito: com o vault na raiz do repo,
# escrever ali jogaria suas conversas dentro do git. Esta pasta é gitignorada.
# Se ficar vazio, a Jade escreve na raiz do vault (comportamento antigo).
JADE_NOTES_DIR=obsidian_notes

# ── Personalidade & memória viva ─────────────────────────────
# Dono da Jade — o comportamento dela é voltado a esta pessoa.
JADE_USER_NAME=Giovanni
# Aprender fatos sobre o usuário (via LLM) ao encerrar/limpar a conversa.
JADE_PROFILE_UPDATE=true

# ── Bancos de dados ──────────────────────────────────────────
CHROMA_DB_PATH=./database/chroma_db
CHROMA_COLLECTION=obsidian_notes
SQLITE_PATH=./database/jade.db

# ── RAG (opcional — têm padrão no código) ────────────────────
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_TOP_K=6
# RAG_MAX_DISTANCE=0.32

# ── Voz (Fase 3) ─────────────────────────────────────────────
# STT local (faster-whisper): tiny|base|small|medium|large-v3
# "small" é bem mais preciso que "base" (nomes próprios, PT-BR misturado com
# títulos em inglês); troque por "base"/"tiny" numa máquina fraca.
JADE_WHISPER_MODEL=small
JADE_WHISPER_LANGUAGE=pt
# Viés de vocabulário do Whisper (nomes/termos que ele erra sem contexto).
# JADE_WHISPER_PROMPT=Jade, tocar, Spotify, playlist, música.
# TTS: edge (online, alta qualidade) | pyttsx3 (offline)
JADE_TTS_BACKEND=edge
# pt-BR-ThalitaMultilingualNeural soa mais natural que a Francisca (voz mais
# nova, mesma geração usada no Copilot). pt-BR-AntonioNeural = voz masculina.
JADE_TTS_VOICE=pt-BR-ThalitaMultilingualNeural
# Prosódia (só backend edge): rate em % relativo, pitch em Hz relativo.
# Ajuda a tirar o tom "robô" de vozes muito neutras.
# JADE_TTS_RATE=+0%
# JADE_TTS_PITCH=+0Hz
# Onde os áudios gerados pelo Jade são salvos (padrão: <vault>/Áudios)
# JADE_AUDIO_DIR=./obsidian_notes/Áudios

# ── Wake-word "Ok Jade" (python main.py listen) ──────────────
# Desligado por padrão: precisa de um modelo openWakeWord custom treinado à
# parte (não existe "ok jade" pronto) — ver docs/wakeword_treino.md.
JADE_WAKEWORD_ENABLED=false
# JADE_WAKEWORD_MODEL_PATH=./database/ok_jade.onnx
# JADE_WAKEWORD_THRESHOLD=0.5
# JADE_WAKEWORD_SILENCE_MS=900
# JADE_WAKEWORD_MAX_SECONDS=12
# JADE_WAKEWORD_VAD_RMS_THRESHOLD=500

# ── API (FastAPI) ────────────────────────────────────────────
JADE_API_HOST=127.0.0.1
JADE_API_PORT=8000

# ── Spotify (Fase 4) ─────────────────────────────────────────
# Client ID/Secret do app registrado em developer.spotify.com/dashboard.
# Sem isso, a integração fica desligada (a tool avisa e não tenta rede).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Precisa bater EXATAMENTE com o Redirect URI cadastrado no Dashboard.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
# SPOTIFY_TOKEN_CACHE_PATH=./database/spotify_token.json
# SPOTIFY_LIBRARY_STALE_HOURS=24
# JADE_SPOTIFY_TOOL_ENABLED=true
